{
  "name": "wordnest-cloudflare",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.0",
    "wrangler": "^4.130.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to \"$PWD/.wrangler/state\"",
    "deploy": "npm run build && npm run deploy:ci",
    "deploy:ci": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --test --test-isolation=none tests/*.test.mjs",
    "types": "wrangler types --env-file .dev.vars.example",
    "deploy:check": "node scripts/deploy.mjs --dry-run"
  },
  "engines": {
    "node": ">=24"
  }
}
