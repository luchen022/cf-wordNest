{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordnest-cloudflare",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  // `main` here is the entry vinext uses for local dev. Deploys use the
  // generated config at dist/server/wrangler.json (see the deploy scripts),
  // which vinext writes during `npm run build` and which merges everything
  // below this line into the built Worker.
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // Keep dashboard-managed text/JSON variables during automatic deployments.
  // Secrets are preserved by Wrangler independently of this setting.
  "keep_vars": true,
  "ai": { "binding": "AI" },
  // Declare only the binding name: reuse whichever D1 is bound as DB in the
  // dashboard. Deployment scripts convert this local declaration into an
  // explicit inherited binding and disable all resource provisioning.
  // Do not pin database_name/database_id for this dashboard-managed workflow.
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  // SESSION_SECRET is configured as a runtime Secret in the dashboard.
  // Deliberately omit secrets.required so the first deploy can succeed before
  // the Worker exists. The login page explains the missing secret at runtime.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "APP_NAME": "WordNest"
  }
}
